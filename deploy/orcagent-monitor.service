[Unit]
Description=OrcAgent uptime monitor — Telegram alert when the app stops writing its heartbeat
After=orcagent.service
Wants=orcagent.service

[Service]
Type=exec
User=orcagent
Group=orcagent
WorkingDirectory=/opt/orcagent
EnvironmentFile=/etc/orcagent.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077

# Separate from the app so monitor restarts never restart trading, and vice
# versa. With no Telegram token configured it stays intentionally silent.
ExecStart=/opt/orcagent/venv/bin/python monitor.py

Restart=always
RestartSec=15

# The monitor only needs to read application state and make normal network
# calls for alerts. It gets no host-management privileges.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/data /opt/orcagent /etc/orcagent.env
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orcagent-monitor

[Install]
WantedBy=multi-user.target
