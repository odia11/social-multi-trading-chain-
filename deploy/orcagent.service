[Unit]
Description=OrcAgent — multi-chain social trading platform
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=orcagent
Group=orcagent
WorkingDirectory=/opt/orcagent
EnvironmentFile=/etc/orcagent.env

# /opt/orcagent is read-only below (ProtectSystem=strict), so let Python skip
# writing .pyc files rather than failing to on every import.
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077

# ONE worker, on purpose. Do not raise this.
# dashboard.py starts its trading/background loops in-process, so extra workers
# would duplicate money-moving work. Threads provide request concurrency while
# retaining one authoritative copy of each loop.
ExecStart=/opt/orcagent/venv/bin/gunicorn app_entry:app \
    --bind 127.0.0.1:8080 \
    --workers 1 \
    --threads 4 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -

# Do not declare a deploy healthy merely because gunicorn opened a socket.
# Check the actual hardening headers, loopback-only bind, env permissions and
# encrypted backup timer. A failed check makes systemd mark startup failed.
ExecStartPost=/bin/bash /opt/orcagent/deploy/security-smoke.sh

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Filesystem isolation: application state belongs only under /data.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data

# Kernel/host hardening. The web process does not need to alter the host,
# load modules, create namespaces, acquire capabilities, use realtime
# scheduling, or switch to setuid/setgid helpers.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

# OrcAgent needs normal TCP/UDP/UNIX sockets for RPC/DEX APIs, DNS and the
# local gunicorn/nginx connection; all other socket families are unnecessary.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Hide other users' process details while leaving the service's own /proc view
# available to Python and native libraries.
ProtectProc=invisible
ProcSubset=pid

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orcagent

[Install]
WantedBy=multi-user.target
