[Unit]
Description=OrcAgent — multi-chain social trading platform
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=orcagent
Group=orcagent
WorkingDirectory=/opt/orcagent
EnvironmentFile=/etc/orcagent.env

# Product invariant: OrcAgent never fronts user gas. Users fund native gas
# from their own trading wallet; platform sponsor balances are irrelevant.
Environment=ORCAGENT_FRONTS_GAS=0

# /opt/orcagent is read-only below (ProtectSystem=strict), so let Python skip
# writing .pyc files rather than failing to on every import.
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077

# Two malloc arenas instead of glibc's default of 8 per CPU core (32 on this
# 4-core VM). The dozens of request and background threads would otherwise
# spread over all of them, and freed memory parked in an arena is rarely
# handed back, so RSS only grows.
# Measured with 8,000 requests over 16 threads: 332 MB RSS with the default,
# 161 MB with this.
Environment=MALLOC_ARENA_MAX=2

# ONE worker, on purpose. Do not raise this.
# dashboard.py starts its trading/background loops in-process, so extra workers
# would duplicate money-moving work. Threads provide request concurrency while
# retaining one authoritative copy of each loop.
#
# 16 threads, not 4: one Home load alone sends ~20 requests, and a request
# waiting on an RPC or price API holds its thread the whole time. With 4,
# a handful of members queued everyone else's feed behind those waits. The
# requests are I/O-bound (they wait, holding no lock), SQLite runs in WAL mode
# with a busy timeout, and it is still one process -- so this adds waiting
# room, not a second copy of anything.
#
# No gunicorn access log: nginx already writes one line per request to
# /var/log/nginx/orcagent.access.log. The second copy went through journald
# for every per-second price poll of every open tab, and filled the journal
# (and the page cache behind it) with lines nobody read. App messages and
# errors still go to the journal as before.
ExecStart=/opt/orcagent/venv/bin/gunicorn app_entry:app \
    --bind 127.0.0.1:8080 \
    --workers 1 \
    --threads 16 \
    --timeout 120 \
    --error-logfile -

# Do not declare a deploy healthy merely because gunicorn opened a socket.
# Check the actual hardening headers, loopback-only bind, env permissions and
# encrypted backup timer. A failed check makes systemd mark startup failed.
ExecStartPost=/bin/bash /opt/orcagent/deploy/security-smoke.sh

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Filesystem isolation: application state belongs only under /data; published
# video posts go to the public media directory nginx serves (the '-' keeps the
# service starting even before install.sh has created it).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data -/var/lib/orcagent-media

# Kernel/host hardening. The web process does not need to alter the host,
# load modules, create namespaces, acquire capabilities, use realtime
# scheduling, or switch to setuid/setgid helpers.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

# OrcAgent needs normal TCP/UDP/UNIX sockets for RPC/DEX APIs, DNS and the
# local gunicorn/nginx connection; all other socket families are unnecessary.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Hide other users' process details while leaving the service's own /proc view
# available to Python and native libraries.
ProtectProc=invisible
ProcSubset=pid

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orcagent

[Install]
WantedBy=multi-user.target
