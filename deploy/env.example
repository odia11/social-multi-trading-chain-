# ── OrcAgent environment ──
# Copied to /etc/orcagent.env by deploy/install.sh. Fill in the values, then
# start the service. Readable only by root and the orcagent user.
#
# Copy each value from your Railway Variables tab. Where a value already
# exists there, use THAT value -- do not generate a new one.

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without these
# ─────────────────────────────────────────────────────────────────────

# THE critical one. Every user's trading key in the database is encrypted
# with this. Copy it from Railway exactly. A new key does not "reset"
# anything -- it makes every stored wallet permanently unreadable, and the
# funds in them unreachable through this app.
ENCRYPTION_KEY=

# Signs login sessions. A new value here just logs everyone out once.
SECRET_KEY=

# Wallets with full admin rights. Accepts a comma-separated list.
OWNER_WALLET=

# Additional admin wallets, unioned with OWNER_WALLET above rather than
# replacing it -- use this if you want to grant/revoke a wallet without
# touching the primary one.
# OWNER_WALLETS=

# ─────────────────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED
# ─────────────────────────────────────────────────────────────────────

# Solana RPC. The public endpoint rate-limits hard; use Helius or similar.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# 0x key used by every EVM swap/bridge. BUYs on BNB Chain, Base, Arbitrum,
# Polygon and Robinhood Chain use the 0x Gasless API so the user does not need
# BNB/ETH/POL first. Network costs are handled inside the user's stablecoin-
# funded order instead of being subsidized by OrcAgent.
ZEROX_API_KEY=

# Jupiter API key for Solana USDC BUYs. When Jupiter offers a gasless route,
# a user with USDC and zero/low SOL can buy without first depositing SOL;
# Jupiter recovers gas/rent from the swap economics. Automatic gasless has a
# provider-controlled minimum amount, so very small zero-SOL orders can be
# refused rather than being subsidized by OrcAgent.
JUPITER_API_KEY=

# AI token scoring and the X buzz discovery. Without credit on this key,
# both features go quiet -- everything else keeps working.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# GAS POLICY — no OrcAgent-funded subsidy
# ─────────────────────────────────────────────────────────────────────
# OrcAgent's own wallet does not hand out native gas.
# - EVM BUYs use 0x Gasless on every supported EVM chain.
# - Solana USDC BUYs use Jupiter gasless when Jupiter offers a qualifying route.
# The amount the user chooses remains the spending ceiling; gas/fees belong
# inside that budget rather than being added on top or paid by OrcAgent.
ORCAGENT_FRONTS_GAS=0

# Legacy platform sponsor keys are intentionally unused under this policy.
# Leave them empty on new installs.
#
# If ORCAGENT_FRONTS_GAS is set to 1 instead, these wallets need a small
# native-token balance on each chain they cover -- not an expense, but float:
# the sponsor pays a user's gas up front and the trade's own quote charges
# that cost back to the user, so the balance comes back trade by trade.
GAS_SPONSOR_PRIVATE_KEY=
SOL_GAS_SPONSOR_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=
BSC_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
ROBINHOOD_RPC_URL=

# X (Twitter) sharing. The callback URL must match the X Developer Portal
# exactly -- including the new domain if you are changing it.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# Passkey/WebAuthn domain. Must be the domain users actually visit.
WEBAUTHN_RP_ID=orcagent.fun

# Uptime alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Port gunicorn binds to. nginx forwards to this; leave it unless you also
# change deploy/nginx-orcagent.conf and deploy/orcagent.service.
PORT=8080

# Route Jupiter (Solana quote/swap) calls through your own proxy instead of
# api.jup.ag directly. Leave both unset to call api.jup.ag directly.
# JUPITER_PROXY_URL=
# JUPITER_PROXY_SECRET=

# Optional shared secret the frontend echoes back on every mutating request --
# defense-in-depth against bots that POST straight to the API without ever
# loading the page. Skipped entirely when unset.
# API_SHARED_SECRET=

# Comma-separated IPs treated as owner/trusted for the honeypot gate's
# logging (this gate logs only -- it never blocks an IP). Optional.
# OWNER_IP_WHITELIST=

# Encrypts daily database backups. Falls back to ENCRYPTION_KEY, then
# SECRET_KEY, when unset -- set this separately only if you want the backup
# encryption key to be independent of those.
# BACKUP_ENCRYPTION_KEY=

# ── Hosting ────────────────────────────────────────────────────────────────
# The site's own domain. The session cookie is scoped to it with a leading dot
# so that www and the bare domain share one login; change this and both names
# need to be on the certificate.
PUBLIC_HOST=orcagent.fun

# Where the database, backups and logs live. Leave this unset to use /data,
# which install.sh creates -- it is here so the location is not fixed by the
# code. It must be outside /opt/orcagent, or a redeploy would sit on top of
# your database.
# DATA_DIR=/data

# DO NOT SET "DEV" ON A SERVER.
# It exists for a laptop running http://localhost. Setting it drops the Secure
# flag from the session cookie and turns off HSTS. These used to be tied to a
# Railway-only variable and switched themselves off silently when the app
# moved hosts, which is exactly the mistake this replaces -- so the safe state
# is now the default and dev is the one that has to be asked for.
# DEV=1


# ── Trade engine ───────────────────────────────────────────────────────────
# Which routes run through trade_engine/ instead of their pre-engine path.
# The engine's guarantee is that the amount a user types is the MAXIMUM that
# leaves their balance: gas, the platform fee and the slippage reserve come
# out of it, the purchase is what remains, and a route that would cost
# OrcAgent anything cannot execute at all. It also claims the money in the
# database before sending (so two trades cannot spend it twice) and keys
# every execution (so a retry cannot become a second swap).
#
# Manual EVM buys. ON by default. Set to 0 to put that one route back on the
# pre-engine path, which swaps the full typed amount and charges the fee on
# top -- a way back if the engine misbehaves, not an equal option.
# TRADE_ENGINE_MANUAL_EVM=1
#
# The autonomous bot's EVM entries. ON by default, and a separate switch from
# the manual one because the blast radius is different: a manual buy is one
# person watching a result, the bot enters on its own, on five chains, for
# every user running it. The bot used to swap the configured trade size in
# full and charge the 0.75% fee on top, so an autonomous entry always debited
# more than the size that was set.
# TRADE_ENGINE_BOT_EVM=1
#
# Solana through the same engine -- both /api/trade/execute and Solana
# copy-trading. ON by default.
#
# Quoting Solana always worked; only execution was refused. The blocker was
# that the swap primitive reports every failure with an empty signature, so a
# transaction that was broadcast and then timed out looked exactly like one
# that was never built -- and guessing wrong in the optimistic direction
# releases a claim on money that may already be gone. The swap now prints an
# explicit verdict around sendTransaction instead ([BROADCAST] sent /
# rejected / unknown) and the executor reads it, so the only case still
# called unknown is a reply genuinely lost in flight.
#
# Setting this to 0 does NOT restore SOL-funded copy-trading. It turns Solana
# copying off, because the path it would fall back to spent SOL while reading
# a dollar-denominated setting.
# TRADE_ENGINE_SOLANA=1
