# ── OrcAgent environment ──
# Copied to /etc/orcagent.env by deploy/install.sh. Fill in the values, then
# start the service. Readable only by root and the orcagent user.
#
# Copy each value from your Railway Variables tab. Where a value already
# exists there, use THAT value -- do not generate a new one.

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without these
# ─────────────────────────────────────────────────────────────────────

# THE critical one. Every user's trading key in the database is encrypted
# with this. Copy it from Railway exactly. A new key does not "reset"
# anything -- it makes every stored wallet permanently unreadable, and the
# funds in them unreachable through this app.
ENCRYPTION_KEY=

# Signs login sessions. A new value here just logs everyone out once.
SECRET_KEY=

# Wallets with full admin rights. Accepts a comma-separated list.
OWNER_WALLET=

# ─────────────────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED
# ─────────────────────────────────────────────────────────────────────

# Solana RPC. The public endpoint rate-limits hard; use Helius or similar.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# 0x key used by every EVM swap/bridge. BUYs on BNB Chain, Base, Arbitrum,
# Polygon and Robinhood Chain use the 0x Gasless API so the user does not need
# BNB/ETH/POL first. Network costs are handled inside the user's stablecoin-
# funded order instead of being subsidized by OrcAgent.
ZEROX_API_KEY=

# Jupiter API key for Solana USDC BUYs. When Jupiter offers a gasless route,
# a user with USDC and zero/low SOL can buy without first depositing SOL;
# Jupiter recovers gas/rent from the swap economics. Automatic gasless has a
# provider-controlled minimum amount, so very small zero-SOL orders can be
# refused rather than being subsidized by OrcAgent.
JUPITER_API_KEY=

# AI token scoring and the X buzz discovery. Without credit on this key,
# both features go quiet -- everything else keeps working.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# GAS POLICY — no OrcAgent-funded subsidy
# ─────────────────────────────────────────────────────────────────────
# OrcAgent's own wallet does not hand out native gas.
# - EVM BUYs use 0x Gasless on every supported EVM chain.
# - Solana USDC BUYs use Jupiter gasless when Jupiter offers a qualifying route.
# The amount the user chooses remains the spending ceiling; gas/fees belong
# inside that budget rather than being added on top or paid by OrcAgent.
ORCAGENT_FRONTS_GAS=0

# Sponsored gas, repaid in the same trade (sponsored_gas.py). Where 0x
# Gasless has no route -- Robinhood Chain, or a token without a gasless route --
# the EVM sponsor wallet fronts exactly the native gas that trade needs and the
# user's wallet pays it back in USDC/USDG before the swap, out of the amount
# they entered. Float, not a subsidy. Fund the sponsor address (printed at
# startup) with a little native gas (ETH/BNB/POL) on each EVM chain.
# ORCAGENT_SPONSORED_GAS=0 turns it off; ORCAGENT_SPONSOR_MAX_USD caps one grant.
GAS_SPONSOR_PRIVATE_KEY=
ORCAGENT_SPONSORED_GAS=1
ORCAGENT_SPONSOR_MAX_USD=1.00

# The Solana sponsor key is intentionally unused under this policy (Jupiter
# gasless covers Solana). Leave it empty on new installs.
SOL_GAS_SPONSOR_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=
BSC_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
ROBINHOOD_RPC_URL=

# X (Twitter) sharing. The callback URL must match the X Developer Portal
# exactly -- including the new domain if you are changing it.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# Passkey/WebAuthn domain. Must be the domain users actually visit.
WEBAUTHN_RP_ID=orcagent.fun

# Uptime alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Port gunicorn binds to. nginx forwards to this; leave it unless you also
# change deploy/nginx-orcagent.conf and deploy/orcagent.service.
PORT=8080

# ── Hosting ────────────────────────────────────────────────────────────────
# The site's own domain. The session cookie is scoped to it with a leading dot
# so that www and the bare domain share one login; change this and both names
# need to be on the certificate.
PUBLIC_HOST=orcagent.fun

# Where the database, backups and logs live. Leave this unset to use /data,
# which install.sh creates -- it is here so the location is not fixed by the
# code. It must be outside /opt/orcagent, or a redeploy would sit on top of
# your database.
# DATA_DIR=/data

# DO NOT SET "DEV" ON A SERVER.
# It exists for a laptop running http://localhost. Setting it drops the Secure
# flag from the session cookie and turns off HSTS. These used to be tied to a
# Railway-only variable and switched themselves off silently when the app
# moved hosts, which is exactly the mistake this replaces -- so the safe state
# is now the default and dev is the one that has to be asked for.
# DEV=1
