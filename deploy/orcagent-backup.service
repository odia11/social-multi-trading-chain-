[Unit]
Description=OrcAgent encrypted database backup
After=local-fs.target

[Service]
Type=oneshot
User=orcagent
Group=orcagent
ExecStart=/bin/bash /opt/orcagent/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077

# SQLite may run in WAL mode. Opening a live WAL database can require access
# to its -wal/-shm sidecars (and creation of -shm when it is absent), so the
# database directory itself must be writable by the same unprivileged service
# user. The backup process still runs as `orcagent`, without capabilities, and
# the script only writes temporary/backup files under /data/backups.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data
ReadOnlyPaths=/etc/orcagent.env /opt/orcagent
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
